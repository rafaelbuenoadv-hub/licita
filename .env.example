# Copie para .env e preencha.
DATABASE_URL=postgres://licita:troque-esta-senha@localhost:5432/licita
# Chave da API da Anthropic (console.anthropic.com). Sem ela o sistema funciona, mas sem IA.
ANTHROPIC_API_KEY=
# Modelo de IA (padrão: claude-opus-5-5)
# LICITA_MODELO=claude-opus-5-5
PORT=3000
# Em produção, com HTTPS, use production (cookie de sessão só por HTTPS).
NODE_ENV=development
