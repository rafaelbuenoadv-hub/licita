{
  "name": "licita",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema de licitações: fase preparatória, plano de contratações anual e gestão de contratos (Lei nº 14.133/2021), com IA",
  "scripts": {
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p server/tsconfig.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "migrate": "tsx --env-file-if-exists=.env server/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env server/seed.ts",
    "novo-orgao": "tsx --env-file-if-exists=.env server/cli-orgao.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 server/test/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "docx": "^9.15.3",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
